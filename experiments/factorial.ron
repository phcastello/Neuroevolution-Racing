// Central scientific base, paired seeds, and operational budget. Preparation is inert.
(
    base: "configs/rl/ppo_e_continue_8h.ron",
    rollouts: 500,
    screening_rollouts: 100,
    seeds: [11],
    repetitions: 1,
    max_parallel: 1,
    backend: "cpu",
    evaluate_every: 100,
    // None follows evaluation cadence (100 when evaluation is disabled).
    checkpoint_every: None,
    save_first: 0,
    save_last: 0,
    save_rollouts: false,
)
